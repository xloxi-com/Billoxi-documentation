# Billoxi — Vercel environment variables
# Import in Vercel: Project → Settings → Environment Variables → Import .env
# Apply to: Production, Preview, and Development

# Public site URL (no trailing slash).
# After first Vercel deploy, replace with your *.vercel.app or custom domain.
NEXT_PUBLIC_SITE_URL=https://www.xloxi.com

# Google Search Console HTML-tag verification value (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools msvalidate.01 value (optional)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
